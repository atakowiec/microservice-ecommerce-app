# Docker image version used by docker-compose.yml
IMAGE_TAG=latest

# Catalog product image storage
AWS_S3_BUCKET=replace-with-your-bucket-name
AWS_REGION=eu-central-1

# Local development only. Prefer an IAM runtime role in production.
AWS_ACCESS_KEY_ID=replace-with-your-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-your-secret-access-key
# Required only when AWS issued temporary credentials.
AWS_SESSION_TOKEN=
